API_GATEWAY_PORT=8000
AI_AGENT_PORT=8001
ORDER_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003

REDIS_URL=redis://localhost:6379/0

ORDER_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003
AI_AGENT_SERVICE_URL=http://localhost:8001

LOCAL_MODEL_NAME=groq
REMOTE_MODEL_NAME=gpt-5
REASONING_COMPLEXITY_THRESHOLD=2
ENABLE_LANGGRAPH=false
SINGLE_RESTAURANT_NAME=Codex Kitchen
ENABLE_LOCAL_LLM_CHAT=true
LOCAL_LLM_TYPE=openai_api
LOCAL_LLM_API_KEY=your-groq-api-key-here
LOCAL_LLM_BASE_URL=https://api.groq.com/openai/v1
LOCAL_LLM_MODEL=openai/gpt-oss-120b
LOCAL_LLM_TIMEOUT_SECONDS=18
ENABLE_LLM_CHAT=true
OPENAI_API_KEY=your-groq-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_CHAT_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=18
LLM_MAX_HISTORY_TURNS=8

PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SECRET=replace-with-secure-secret
